{
  "manifest_version": 3,
  "name": "TicketClub Discord Watcher",
  "version": "1.0.0",
  "description": "Automaticky otvára Ticketmaster linky z Discord alertov",
  "permissions": ["activeTab", "storage", "notifications", "scripting", "tabs"],
  "host_permissions": [
    "https://*.ticketmaster.com/*",
    "https://*.ticketmaster.cz/*",
    "https://*.ticketmaster.sk/*",
    "https://*.ticketmaster.de/*",
    "https://*.ticketmaster.co.uk/*",
    "https://*.ticketmaster.be/*",
    "https://*.ticketmaster.nl/*",
    "https://*.ticketmaster.at/*",
    "https://app.ticketclub.vip/*",
    "https://eoeiuohwxulkgppjaogk.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
